NODE_ENV=production
HOST=0.0.0.0
PORT=8765

# 首次启动时创建 admin 所用，至少 12 位。创建 data/users.json 后仍应妥善保存。
INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password

# 会话有效期，默认 8 小时
SESSION_TTL_MS=28800000
BODY_LIMIT_BYTES=2097152

# 第三方密钥只能放环境变量，禁止填写到页面或提交 Git
DEEPSEEK_API_KEY=
TIANYANCHA_API_KEY=
QCC_API_KEY=
